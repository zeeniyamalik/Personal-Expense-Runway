# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL password for the root user (database: expense_tracker on localhost:3306)
DB_PASSWORD=

# Any long random string, used to sign login tokens
JWT_SECRET=

# Google Gemini API key (https://aistudio.google.com/apikey). Without it the AI features answer 503.
GEMINI_API_KEY=

# Optional: real password reset emails. Leave MAIL_SENDER empty to print them in the console.
MAIL_SENDER=
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: the site address used in reset links (default http://localhost:8080)
APP_BASE_URL=
